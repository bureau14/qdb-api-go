# Temporary scaffolding for sc-20192 experiments (snapshot dependencies).
# The agent sources this repository hook before every command step. When
# SC20192_SPIKE_EXPORTS is set (semicolon-separated NAME=value pairs), each
# pair is exported into the step's environment; entries without "=" are
# skipped. Unset or empty, the hook does nothing.
if [[ -n "${SC20192_SPIKE_EXPORTS:-}" ]]; then
  _sc20192_rest="${SC20192_SPIKE_EXPORTS};"
  while [[ -n "${_sc20192_rest}" ]]; do
    _sc20192_pair="${_sc20192_rest%%;*}"
    _sc20192_rest="${_sc20192_rest#*;}"
    if [[ "${_sc20192_pair}" == *=* ]]; then
      export "${_sc20192_pair}"
      echo "sc-20192: exported ${_sc20192_pair%%=*}"
    fi
  done
  unset _sc20192_rest _sc20192_pair
fi
